---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";

const eyebrow =
  "inline-block rounded-full border border-line-4 px-[15px] py-[7px] text-[12.5px] font-semibold uppercase tracking-[0.06em] text-brand";

const chip =
  "rounded-full bg-chip px-3.5 py-2 text-[14px] font-medium";

const skills = [
  {
    title: "Engineering",
    tags: ["TypeScript", "React", "Node.js", "Python", "System architecture", "Full-stack"],
  },
  {
    title: "Platform & Security",
    tags: ["Okta / Auth0", "Identity & access", "Compliance", "AWS", "Incident response"],
  },
  {
    title: "The human side",
    tags: ["Technical discovery", "Cross-functional alignment", "Docs & enablement", "Stakeholder trust"],
  },
];

const experience = [
  {
    title: "0-to-1 product architecture",
    body: "Spearheaded the architecture and launch of the Okta Private Cloud Status Page, centralizing system-health visibility for enterprise clients and reducing status-related support tickets.",
  },
  {
    title: "Auth0 documentation migration",
    body: "Led the platform migration from Contentful to Mintlify and authored the primary architectural docs that enabled cross-team alignment and faster onboarding.",
  },
  {
    title: "Security Champion (SecChamp)",
    body: "Partnered with security and engineering to translate compliance requirements into technical decisions, balancing risk, usability, and velocity.",
  },
  {
    title: "Platform migrations & discovery",
    body: "Managed multi-service migrations (Layer0 Central) to 100% delivery, and facilitated technical discovery sessions that aligned engineering, product, and security early to de-risk complex work.",
  },
  {
    title: "Incident response & internal tooling",
    body: "Drove enterprise incident resolution across platform teams and engineered an internal account-lookup platform that cut retrieval times from minutes to seconds.",
  },
];
---

<Layout active="home">
  <!-- HERO -->
  <section class="bg-paper">
    <div
      class="mx-auto grid max-w-[1200px] items-center gap-14 px-6 py-16 md:px-10 md:py-20 lg:grid-cols-2 lg:gap-14"
    >
      <div>
        <span
          class="inline-block rounded-full bg-chip px-[15px] py-[7px] text-[13px] font-semibold text-brand"
          >Software Engineer → Sales Engineer</span
        >
        <h1
          class="mt-5 font-display text-[clamp(2.5rem,5vw,4.125rem)] font-extrabold leading-[1.02] tracking-[-0.03em]"
        >
          I build the bridge between the code and the <span class="text-brand"
            >customer.</span
          >
        </h1>
        <p class="mt-5 max-w-[46ch] text-[18px] leading-relaxed text-muted">
          Five years building platform, security, and reliability at Okta &amp;
          Auth0 — now in front of the customers who depend on it.
        </p>
        <div class="mt-8 flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="rounded-full bg-brand px-[26px] py-[15px] text-[16px] font-semibold text-white transition-opacity hover:opacity-90"
            >Let's talk</a
          >
          <a
            href="#work"
            class="rounded-full border border-line-3 bg-white px-[26px] py-[15px] text-[16px] font-semibold text-ink transition-colors hover:border-brand"
            >See my work</a
          >
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2">
          <span class="text-[13px] font-medium text-muted-2">Trusted on:</span>
          <span class="font-display font-bold text-muted-3">Okta</span>
          <span class="font-display font-bold text-muted-3">Auth0</span>
          <span class="font-display font-bold text-muted-3">AWS</span>
        </div>
      </div>

      <!-- Decorative product cluster (desktop only) -->
      <div class="relative hidden min-h-[460px] lg:block">
        <div
          class="absolute right-0 top-0 w-[300px] rounded-[20px] border border-[#EFEAFB] bg-white p-[22px] shadow-[0_24px_50px_-20px_rgba(75,47,191,0.3)]"
        >
          <div class="flex items-center justify-between">
            <span class="text-[14px] font-semibold">System status</span>
            <span
              class="inline-flex items-center gap-1.5 text-[12.5px] font-semibold text-success"
              ><span class="h-[7px] w-[7px] rounded-full bg-success"></span
              >Operational</span
            >
          </div>
          <div class="mt-4 flex flex-col gap-[9px]">
            <div class="flex items-center justify-between">
              <span class="text-[13px] text-muted">Authentication</span>
              <span class="h-2 w-[90px] rounded bg-success"></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-[13px] text-muted">Management API</span>
              <span class="h-2 w-[90px] rounded bg-success"></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-[13px] text-muted">Dashboard</span>
              <span class="h-2 w-[90px] rounded bg-[#E5B93B]"></span>
            </div>
          </div>
        </div>

        <div
          class="absolute left-0 top-[172px] w-[250px] rounded-[20px] bg-ink p-[22px] text-white shadow-[0_24px_50px_-20px_rgba(23,20,32,0.4)]"
        >
          <div class="text-[13px] text-mist">Status-related tickets</div>
          <div
            class="mt-1 font-display text-[40px] font-extrabold tracking-[-0.02em]"
          >
            −42%
          </div>
          <div class="mt-3.5 flex h-[46px] items-end gap-1.5">
            <span class="h-full flex-1 rounded-[3px] bg-brand-dark"></span>
            <span class="h-[74%] flex-1 rounded-[3px] bg-brand"></span>
            <span class="h-[58%] flex-1 rounded-[3px] bg-brand"></span>
            <span class="h-[40%] flex-1 rounded-[3px] bg-brand-light"></span>
            <span class="h-[30%] flex-1 rounded-[3px] bg-accent"></span>
          </div>
        </div>

        <div
          class="absolute bottom-0 right-5 w-[270px] rounded-[20px] border border-[#EFEAFB] bg-white p-5 shadow-[0_24px_50px_-20px_rgba(75,47,191,0.3)]"
        >
          <div class="mb-3 text-[14px] font-semibold">Tenant Logs Explorer</div>
          <div class="flex flex-col gap-[7px] font-mono">
            <div class="flex items-center gap-2.5 text-[12px]">
              <span class="font-semibold text-success">success.login</span>
              <span class="text-[#B7B0C6]">14:02:11</span>
            </div>
            <div class="flex items-center gap-2.5 text-[12px]">
              <span class="font-semibold text-brand">success.signup</span>
              <span class="text-[#B7B0C6]">14:02:09</span>
            </div>
            <div class="flex items-center gap-2.5 text-[12px]">
              <span class="font-semibold text-[#E5843B]">failed.login</span>
              <span class="text-[#B7B0C6]">14:01:58</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="border-y border-line bg-white">
    <div
      class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-center gap-x-10 gap-y-4 px-6 py-[26px] md:px-10"
    >
      <span
        class="text-[13px] font-medium tracking-[0.04em] text-muted-2"
        >FIVE YEARS OF WORK ACROSS</span
      >
      {
        ["Okta", "Auth0", "Layer0", "Contentful", "Mintlify"].map((name) => (
          <span class="font-display text-[20px] font-bold text-ink/80">
            {name}
          </span>
        ))
      }
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section
    class="mx-auto grid max-w-[1200px] gap-12 px-6 py-20 md:grid-cols-[0.9fr_1.1fr] md:gap-[72px] md:px-10 md:py-24"
  >
    <div>
      <span class={eyebrow}>About</span>
      <h2
        class="mt-[22px] font-display text-[clamp(1.875rem,3.6vw,2.875rem)] font-bold leading-[1.06] tracking-[-0.02em]"
      >
        The engineer who'd rather be in the room.
      </h2>
    </div>
    <div>
      <p class="text-[19px] leading-[1.65] text-ink-700">
        Whether I'm designing software, leading a technical initiative, or
        exploring a new idea, I'm happiest when I'm building something that
        improves people's lives — especially their relationships.
      </p>
      <p class="mt-[22px] text-[17px] leading-[1.65] text-muted">
        For five years at Okta and Auth0 I've owned architecture for platforms
        enterprise customers depend on: a status page they trust during
        incidents, internal tooling that turns minutes of digging into seconds,
        migrations delivered at 100%. The through-line was never the stack. It
        was translating between the people who build the system and the people
        who rely on it. That's the work I want to do full-time as a sales
        engineer.
      </p>
      <div class="mt-9 flex flex-wrap gap-x-11 gap-y-6">
        {
          [
            ["5+", "years engineering"],
            ["100%", "migration delivery"],
            ["0→1", "products launched"],
          ].map(([stat, label]) => (
            <div>
              <div class="font-display text-[40px] font-extrabold tracking-[-0.02em] text-brand">
                {stat}
              </div>
              <div class="mt-0.5 text-[14px] text-muted-2">{label}</div>
            </div>
          ))
        }
      </div>
      <a
        href="/about"
        class="mt-8 inline-flex text-[15px] font-semibold text-brand hover:text-brand-deep"
        >Read my full story →</a
      >
    </div>
  </section>

  <!-- SKILLS TEASER -->
  <section class="bg-surface">
    <div class="mx-auto max-w-[1200px] px-6 py-20 md:px-10 md:py-24">
      <span class={eyebrow}>Skills &amp; Tools</span>
      <h2
        class="mt-5 font-display text-[clamp(1.75rem,3.4vw,2.625rem)] font-bold tracking-[-0.02em]"
      >
        What I bring into the conversation.
      </h2>
      <div class="mt-11 grid gap-[22px] sm:grid-cols-2 lg:grid-cols-3">
        {
          skills.map((group) => (
            <div class="rounded-[20px] border border-line-2 bg-white p-[30px]">
              <div class="mb-4 font-display text-[18px] font-bold">
                {group.title}
              </div>
              <div class="flex flex-wrap gap-[9px]">
                {group.tags.map((tag) => (
                  <span class={chip}>{tag}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <a
        href="/skills"
        class="mt-9 inline-flex text-[15px] font-semibold text-brand hover:text-brand-deep"
        >See the full toolkit →</a
      >
    </div>
  </section>

  <!-- WORK -->
  <section
    id="work"
    class="mx-auto max-w-[1200px] px-6 py-20 md:px-10 md:py-24"
  >
    <span class={eyebrow}>Selected Work</span>
    <h2
      class="mt-5 font-display text-[clamp(1.75rem,3.4vw,2.625rem)] font-bold tracking-[-0.02em]"
    >
      Things I built that people relied on.
    </h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <article
        class="flex flex-col overflow-hidden rounded-[22px] border border-line bg-white"
      >
        <div
          class="grid h-[190px] place-items-center border-b border-[#EFEAFB] bg-[linear-gradient(135deg,#EFEAFE,#FBEAF3)]"
        >
          <div
            class="-mb-px w-[74%] rounded-t-xl bg-white p-4 shadow-[0_12px_30px_-12px_rgba(75,47,191,0.35)]"
          >
            <div class="flex items-center justify-between">
              <span class="text-[12px] font-semibold">Okta Status</span>
              <span
                class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-success"
                ><span class="h-1.5 w-1.5 rounded-full bg-success"></span
                >Operational</span
              >
            </div>
            <div class="mt-3 h-1.5 w-full rounded-[3px] bg-success"></div>
            <div class="mt-[7px] h-1.5 w-4/5 rounded-[3px] bg-[#DCEFE3]"></div>
          </div>
        </div>
        <div class="flex flex-1 flex-col p-[26px]">
          <span class="font-mono text-[12px] tracking-[0.02em] text-muted-3"
            >0→1 · ENTERPRISE</span
          >
          <h3 class="mt-2 font-display text-[20px] font-bold tracking-[-0.01em]">
            Auth0 Status Page
          </h3>
          <p class="mt-2.5 text-[14.5px] leading-[1.55] text-muted">
            Led end-to-end architecture for environment-specific status
            visibility — giving enterprise customers accurate, real-time insight
            during critical incidents and cutting status-related support tickets.
          </p>
        </div>
      </article>

      <article
        class="flex flex-col overflow-hidden rounded-[22px] border border-line bg-white"
      >
        <div
          class="grid h-[190px] place-items-center bg-[linear-gradient(135deg,#171420,#3A2E6B)]"
        >
          <div
            class="w-[74%] rounded-xl bg-[#221E30] p-4 shadow-[0_12px_30px_-12px_rgba(0,0,0,0.5)]"
          >
            <div
              class="flex items-center gap-1.5 font-mono text-[11px] text-lilac"
            >
              <span class="text-brand">&gt;</span> lookup --account 4821
            </div>
            <div class="mt-3 h-[5px] w-[90%] rounded-[3px] bg-brand"></div>
            <div class="mt-[7px] h-[5px] w-[60%] rounded-[3px] bg-[#40395A]"></div>
            <div class="mt-[7px] h-[5px] w-[75%] rounded-[3px] bg-[#40395A]"></div>
          </div>
        </div>
        <div class="flex flex-1 flex-col p-[26px]">
          <span class="font-mono text-[12px] tracking-[0.02em] text-muted-3"
            >INTERNAL TOOLING</span
          >
          <h3 class="mt-2 font-display text-[20px] font-bold tracking-[-0.01em]">
            Account Lookup Platform
          </h3>
          <p class="mt-2.5 text-[14.5px] leading-[1.55] text-muted">
            A full-stack tool that replaced fragmented manual processes, cutting
            data retrieval from minutes to seconds so support teams could resolve
            customer investigations without hopping across systems.
          </p>
        </div>
      </article>

      <article
        class="flex flex-col overflow-hidden rounded-[22px] border border-line bg-white sm:col-span-2 lg:col-span-1"
      >
        <div
          class="grid h-[190px] place-items-center bg-[linear-gradient(135deg,#EFEAFE,#E6DEFB)]"
        >
          <div
            class="w-[74%] rounded-xl bg-white p-3.5 font-mono shadow-[0_12px_30px_-12px_rgba(75,47,191,0.35)]"
          >
            <div class="text-[11px] font-semibold text-success">
              success.login
            </div>
            <div class="mt-1.5 text-[11px] font-semibold text-brand">
              success.signup
            </div>
            <div class="mt-1.5 text-[11px] font-semibold text-[#E5843B]">
              failed.login
            </div>
          </div>
        </div>
        <div class="flex flex-1 flex-col p-[26px]">
          <span class="font-mono text-[12px] tracking-[0.02em] text-muted-3"
            >DEVELOPER ENABLEMENT</span
          >
          <h3 class="mt-2 font-display text-[20px] font-bold tracking-[-0.01em]">
            Tenant Logs Explorer
          </h3>
          <p class="mt-2.5 text-[14.5px] leading-[1.55] text-muted">
            An easy, searchable reference for every Auth0 tenant log event type —
            turning scattered tribal knowledge into something any team could look
            up in seconds.
          </p>
        </div>
      </article>
    </div>
    <p class="mt-9 text-[15px] text-muted-2">
      Also: led the Auth0 docs migration (Contentful → Mintlify), served as
      Security Champion, and drove the Layer0 Central platform migration to 100%
      on-time delivery.
    </p>
  </section>

  <!-- EXPERIENCE -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-[1200px] px-6 py-20 md:px-10 md:py-24">
      <div class="grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-[60px]">
        <div>
          <span
            class="inline-block rounded-full border border-ink-line-2 px-[15px] py-[7px] text-[12.5px] font-semibold uppercase tracking-[0.06em] text-lilac"
            >Experience</span
          >
          <h2
            class="mt-5 font-display text-[clamp(1.75rem,3.4vw,2.75rem)] font-bold leading-[1.05] tracking-[-0.02em]"
          >
            Software Engineer &amp; Technical Leader
          </h2>
          <div class="mt-[22px] flex flex-wrap items-center gap-3">
            <span class="font-display text-[20px] font-bold">Okta</span>
            <span class="text-muted-2">·</span>
            <span class="text-[15px] text-mist"
              >Jun 2021 — Jul 2026 · 5 yrs 2 mos</span
            >
          </div>
          <div class="mt-1.5 text-[14.5px] text-muted-3">
            Seattle, Washington · Remote
          </div>
        </div>
        <div class="flex flex-col">
          {
            experience.map((item) => (
              <div class="border-t border-ink-line py-[22px]">
                <div class="font-display text-[17px] font-semibold text-lilac">
                  {item.title}
                </div>
                <p class="mt-[7px] text-[15px] leading-[1.55] text-mist">
                  {item.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Contact />
</Layout>
