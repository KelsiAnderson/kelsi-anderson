---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";

const lightEyebrow =
  "inline-block rounded-full border border-line-4 px-[15px] py-[7px] text-[12.5px] font-semibold uppercase tracking-[0.06em] text-brand";
const darkEyebrow =
  "inline-block rounded-full border border-ink-line-2 px-[15px] py-[7px] text-[12.5px] font-semibold uppercase tracking-[0.06em] text-lilac";
const chip = "rounded-full bg-chip px-3.5 py-2 text-[14px] font-medium";

const bars = [
  { label: "System architecture", tag: "Expert", pct: 94 },
  { label: "Identity & access", tag: "Expert", pct: 92 },
  { label: "Full-stack development", tag: "Advanced", pct: 88 },
  { label: "Technical communication", tag: "Expert", pct: 95 },
  { label: "Security & compliance", tag: "Advanced", pct: 85 },
  { label: "Cross-functional leadership", tag: "Expert", pct: 90 },
];

const cats = [
  {
    title: "Engineering",
    blurb: "The hands-on stack I ship with, frontend through infrastructure.",
    tags: ["TypeScript", "JavaScript", "React", "Node.js", "Python", "REST & APIs", "System design", "Full-stack"],
  },
  {
    title: "Platform & Security",
    blurb: "Identity, access, and the reliability work enterprises depend on.",
    tags: ["Okta", "Auth0", "IAM / SSO", "Compliance", "Incident response", "AWS", "Observability"],
  },
  {
    title: "Tools & Delivery",
    blurb: "How I build, document, and ship alongside teams.",
    tags: ["Git", "CI/CD", "Mintlify", "Contentful", "Docs-as-code", "Agile", "Salesforce"],
  },
  {
    title: "The human side",
    blurb: "The skills that turn technical depth into trust and alignment.",
    tags: ["Technical discovery", "Stakeholder alignment", "Enablement", "Presenting", "Objection handling", "Territory account management", "Competitive positioning", "Mentoring"],
  },
];

const bridge = [
  {
    title: "Technical discovery",
    body: "Ran cross-functional discovery that aligned engineering, product, and security — the same muscle as scoping a customer's real needs.",
  },
  {
    title: "Demos that hold up",
    body: "I build working proofs — status pages, internal tools — so I can show a solution, field the hard question, and stand behind the answer.",
  },
  {
    title: "Objection handling",
    body: "Security Champion work meant translating risk and compliance into decisions — exactly the trust-building an SE does under scrutiny.",
  },
  {
    title: "Full-cycle ownership",
    body: "Territory account management taught me to own the outcome, not just the technical piece — quota, retention, competitive position all sat on my desk. That end-to-end accountability is exactly what SE work rewards.",
  },
];
---

<Layout
  active="skills"
  title="Skills — Kelsi Anderson"
  description="Kelsi Anderson's skills and toolkit: engineering depth across identity, security, and full-stack, plus the human range of a solutions engineer."
>
  <!-- INTRO -->
  <section class="bg-[linear-gradient(160deg,#EFEAFE_0%,#F4ECFB_50%,#FBEAF3_100%)]">
    <div class="mx-auto max-w-[1200px] px-6 py-16 md:px-10 md:py-20">
      <span
        class="inline-block rounded-full border border-line-3 bg-white px-[15px] py-[7px] text-[12.5px] font-semibold uppercase tracking-[0.06em] text-brand"
        >Skills &amp; Toolkit</span
      >
      <h1
        class="mt-6 max-w-[18ch] font-display text-[clamp(2.5rem,5.2vw,4.375rem)] font-extrabold leading-none tracking-[-0.03em] text-balance"
      >
        The engineering depth, plus the <span class="text-brand"
          >human range.</span
        >
      </h1>
      <p class="mt-6 max-w-[58ch] text-[19px] leading-[1.62] text-muted">
        Five years of shipping real systems gave me technical credibility. The
        way I led, translated, and aligned teams around them is what makes me
        ready for solutions engineering. Here's the full picture.
      </p>
      <div class="mt-10 flex flex-wrap gap-x-11 gap-y-6">
        {
          [
            ["5+", "years hands-on"],
            ["Full-stack", "frontend to infra"],
            ["IAM", "identity & security depth"],
          ].map(([stat, label]) => (
            <div>
              <div class="font-display text-[38px] font-extrabold tracking-[-0.02em] text-brand">
                {stat}
              </div>
              <div class="mt-0.5 text-[14px] text-muted-2">{label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CORE COMPETENCIES -->
  <section class="mx-auto max-w-[1200px] px-6 py-20 md:px-10 md:py-24">
    <span class={lightEyebrow}>Core competencies</span>
    <h2
      class="mt-5 font-display text-[clamp(1.75rem,3.4vw,2.625rem)] font-bold tracking-[-0.02em]"
    >
      Where I'm strongest.
    </h2>
    <div class="mt-12 grid gap-x-16 gap-y-10 md:grid-cols-2">
      {
        bars.map((b) => (
          <div>
            <div class="mb-3 flex items-baseline justify-between">
              <span class="font-display text-[17px] font-semibold">
                {b.label}
              </span>
              <span class="text-[13px] font-medium text-muted-3">{b.tag}</span>
            </div>
            <div class="h-[9px] overflow-hidden rounded-md bg-[#EDE7F8]">
              <div
                class="h-full rounded-md bg-[linear-gradient(90deg,#6A45F3,#E169C9)]"
                style={`width:${b.pct}%`}
              />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FULL TOOLKIT -->
  <section class="bg-surface">
    <div class="mx-auto max-w-[1200px] px-6 py-20 md:px-10 md:py-24">
      <span class={lightEyebrow}>The full toolkit</span>
      <h2
        class="mt-5 font-display text-[clamp(1.75rem,3.4vw,2.625rem)] font-bold tracking-[-0.02em]"
      >
        Everything I bring to the table.
      </h2>
      <div class="mt-11 grid gap-[22px] md:grid-cols-2">
        {
          cats.map((c) => (
            <div class="rounded-[20px] border border-line-2 bg-white p-8">
              <div class="mb-[18px] flex items-center gap-3.5">
                <div class="h-[42px] w-[42px] flex-none rounded-xl bg-[linear-gradient(140deg,#6A45F3,#4B2FBF)]" />
                <div class="font-display text-[19px] font-bold">{c.title}</div>
              </div>
              <p class="mb-[18px] text-[14.5px] leading-[1.55] text-muted-2">
                {c.blurb}
              </p>
              <div class="flex flex-wrap gap-[9px]">
                {c.tags.map((t) => (
                  <span class={chip}>{t}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SE BRIDGE -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-[1200px] px-6 py-20 md:px-10 md:py-24">
      <div class="max-w-[62ch]">
        <span class={darkEyebrow}>Built for solutions engineering</span>
        <h2
          class="mt-5 font-display text-[clamp(1.75rem,3.4vw,2.625rem)] font-bold leading-[1.08] tracking-[-0.02em]"
        >
          How the engineering translates to the SE role.
        </h2>
      </div>
      <div class="mt-11 grid gap-5 md:grid-cols-2">
        {
          bridge.map((b) => (
            <div class="rounded-[20px] border border-ink-line-2 bg-ink-800 p-7">
              <div class="font-display text-[17px] font-bold text-lilac">
                {b.title}
              </div>
              <p class="mt-2.5 text-[14.5px] leading-[1.55] text-mist">
                {b.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Contact
    title="Think I'd fit your team? Let's talk."
    subtitle="I'd love to walk you through any of this in more depth — and hear about the problems your customers are trying to solve."
    emailLabel="Kelsi.Anderson26@gmail.com"
  />
</Layout>
