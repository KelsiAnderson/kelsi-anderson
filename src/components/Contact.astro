---
interface Props {
  title?: string;
  subtitle?: string;
  emailLabel?: string;
}
const {
  title = "Let's build something people trust.",
  subtitle = "Looking for a solutions engineer who can go deep with your customers? I'd love to talk.",
  emailLabel = "Email",
} = Astro.props;

const email = "Kelsi.Anderson26@gmail.com";
---

<section
  id="contact"
  class="bg-linear-160 from-[#EFEAFE] to-[#FBEAF3]"
>
  <div class="mx-auto max-w-[1200px] px-6 py-24 text-center md:px-10 md:py-28">
    <span
      class="inline-block rounded-full border border-line-3 bg-white px-[15px] py-[7px] text-[12.5px] font-semibold uppercase tracking-[0.06em] text-brand"
      >Contact</span
    >
    <h2
      class="mx-auto mt-6 max-w-[16ch] font-display text-[clamp(2.375rem,5.5vw,4.5rem)] font-extrabold leading-none tracking-[-0.03em] text-balance"
    >
      {title}
    </h2>
    <p class="mx-auto mt-6 max-w-[46ch] text-[19px] leading-relaxed text-muted">
      {subtitle}
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3.5">
      <a
        href={`mailto:${email}`}
        class="rounded-full bg-brand px-7 py-[15px] text-[16px] font-semibold text-white transition-opacity hover:opacity-90"
        >{emailLabel}</a
      >
      <a
        href="https://www.linkedin.com/in/kelsi-anderson/"
        class="rounded-full border border-line-3 bg-white px-[26px] py-[15px] text-[16px] font-semibold text-ink transition-colors hover:border-brand"
        >LinkedIn</a
      >
      <a
        href="https://github.com/KelsiAnderson"
        class="rounded-full border border-line-3 bg-white px-[26px] py-[15px] text-[16px] font-semibold text-ink transition-colors hover:border-brand"
        >GitHub</a
      >
    </div>
  </div>
</section>
